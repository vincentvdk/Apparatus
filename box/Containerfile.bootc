# bootc-compatible Containerfile for apparatus-box
# This image can be used as a bootc base and upgraded with `bootc upgrade`

ARG BASE_IMAGE_VERSION="43"
ARG BASE_IMAGE="docker.io/fedora"

# == DELIVERY image (contains scripts and files)
FROM ${BASE_IMAGE}:${BASE_IMAGE_VERSION} as delivery
COPY box/build_files /build_files
COPY box/config /build_files/config

# == IMAGE
FROM ${BASE_IMAGE}:${BASE_IMAGE_VERSION}

# -- bootc annotations (required for bootc compatibility)
LABEL org.opencontainers.image.title="apparatus-box"
LABEL org.opencontainers.image.description="A DevOps/SRE Distrobox"
LABEL org.opencontainers.image.vendor="Apparatus"
LABEL org.opencontainers.image.version="${BASE_IMAGE_VERSION}"
LABEL org.opencontainers.image.url="https://github.com/vincentvdk/apparatus"
LABEL org.opencontainers.image.source="https://github.com/vincentvdk/apparatus"
LABEL org.opencontainers.image.revision="${GITHUB_SHA}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"

# -- bootc-specific labels
LABEL io.github.containers.bootc="true"
LABEL io.k8s.display-name="apparatus-box"
LABEL io.openshift.tags="bootc,distrobox,toolbox"

# -- Set zsh as default shell
ENV SHELL=/usr/bin/zsh

# -- Host command symlinks (distrobox-host-exec)
RUN ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/docker && \
    ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/podman && \
    ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/flatpak && \
    ln -sf /usr/bin/distrobox-host-exec /usr/bin/gsettings

# -- Skip installing docs/man pages
RUN echo -e "tsflags=nodocs" >> /etc/dnf/dnf.conf

# -- Packages
# Distrobox required packages (to skip "Installing basic packages" on every start)
# See: https://github.com/89luca89/distrobox/issues/1734
RUN dnf install -y \
    bash bash-completion bc bzip2 curl diffutils findutils \
    hostname iproute iputils less lsof ncurses \
    openssh-clients passwd pigz procps-ng rsync shadow-utils sudo \
    time tree tzdata unzip util-linux vte-profile wget which xz zip \
    mesa-dri-drivers mesa-vulkan-drivers vulkan \
    # Apparatus specific packages
    zsh fuse fuse-libs git ripgrep bat wl-clipboard flatpak-spawn gawk gcc gcc-c++ && \
    sed -i 's|SHELL=/bin/bash|SHELL=/usr/bin/zsh|' /etc/default/useradd && \
    dnf clean all

# -- mise
ARG VERSION_MISE="2025.1.6"
RUN curl -L "https://github.com/jdx/mise/releases/download/v${VERSION_MISE}/mise-v${VERSION_MISE}-linux-x64" -o /usr/local/bin/mise && \
    chmod +x /usr/local/bin/mise

# -- Charm
ARG VERSION_GUM="0.14.5"
RUN curl -OL https://github.com/charmbracelet/gum/releases/download/v${VERSION_GUM}/gum_${VERSION_GUM}_Linux_x86_64.tar.gz && \
  tar -C /usr/local/bin --strip-components=1 -xzf gum_${VERSION_GUM}_Linux_x86_64.tar.gz gum_${VERSION_GUM}_Linux_x86_64/gum && \
  rm gum_${VERSION_GUM}_Linux_x86_64.tar.gz

# -- NeoVim
ARG VERSION_NEOVIM="0.11.5"
RUN mkdir /opt/nvim &&\
    curl -OL https://github.com/neovim/neovim/releases/download/v${VERSION_NEOVIM}/nvim-linux-x86_64.tar.gz &&\
    tar -C /opt -xzf nvim-linux-x86_64.tar.gz &&\
    rm nvim-linux-x86_64.tar.gz

# -- Chezmoi
ARG CHEZMOI_VERSION="2.52.2"
RUN curl -OL https://github.com/twpayne/chezmoi/releases/download/v${CHEZMOI_VERSION}/chezmoi_${CHEZMOI_VERSION}_linux_amd64.tar.gz && \
  tar -C /usr/local/bin -xzf "chezmoi_${CHEZMOI_VERSION}_linux_amd64.tar.gz"

# -- Environment variables
COPY --from=delivery /build_files/system/profile-custom.sh /etc/profile.d/99-custom.sh
## -- Set ZDOTDIR early (before zsh looks for ~/.zshrc)
COPY --from=delivery /build_files/system/zshenv /etc/zshenv
## -- Clone official dotfiles repo for default configs
ARG DOTFILES_REPO="https://github.com/vincentvdk/apparatus-dotfiles.git"
RUN git clone --depth=1 "$DOTFILES_REPO" /tmp/dotfiles && \
    mkdir -p /usr/share/apparatus && \
    cd /tmp/dotfiles/home/dot_config && \
    for dir in zsh atuin nvim; do \
        [ -d "$dir" ] && cp -r "$dir" /usr/share/apparatus/; \
    done && \
    cd /usr/share/apparatus && \
    find . -name 'dot_*' | while read f; do \
        d=$(dirname "$f"); b=$(basename "$f"); \
        mv "$f" "$d/.${b#dot_}"; \
    done && \
    cp -r /tmp/dotfiles/themes /usr/share/apparatus/themes && \
    rm -rf /tmp/dotfiles

## -- Butler-tools config (not in dotfiles repo)
COPY --from=delivery /build_files/config/tools.yaml /usr/share/apparatus/

## -- Scripts
COPY --chmod=0755 box/bin/ /opt/bin
COPY --chmod=0755 box/bin/init.sh /opt/apparatus/init.sh

## -- Butler binary (from builder stage)
FROM docker.io/golang:1.22-alpine AS builder
WORKDIR /build
COPY box/cmd/butler/ .
RUN go build -o butler .

COPY --from=builder /build/butler /usr/local/bin/butler

# -- Final ostree commit for bootc
RUN ostree container commit
