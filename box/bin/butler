#!/usr/bin/env zsh
#set -x

logo='
   _____                                          __
  /  _  \  ______  ______ _____  _______ _____  _/  |_  __ __  ______
 /  /_\  \ \____ \ \____ \\__  \ \_  __ \\__  \ \   __\|  |  \/  ___/
/    |    \|  |_> >|  |_> >/ __ \_|  | \/ / __ \_|  |  |  |  /\___ \
\____|__  /|   __/ |   __/(____  /|__|   (____  /|__|  |____//____  >
        \/ |__|    |__|        \/             \/                  \/

'

echo -e "$logo"

# Check for config updates (quick, non-blocking)
check_config_updates() {
    if [[ -d "${HOME}/.local/share/chezmoi" ]]; then
        local DIFF=$(chezmoi diff 2>/dev/null | head -1)
        if [[ -n "$DIFF" ]]; then
            echo '{{ Color "3" "Config updates available. Select Update Config to apply." }}' | gum format -t template
            echo ""
        fi
    fi
}

check_config_updates

# Available options
OPTIONS=(
  "Init              - Initialize a new Apparatus box"
  "Manage Tools      - Install and manage tools"
  "Update Config     - Check and apply config updates"
  "Config Source     - Switch dotfiles repo"
  "Theme             - Select a theme"
  "Font              - Switch system font"
  "Exit              - Exit butler"
)

# -- Main func
main() {
  while true; do
    local OPT=$(gum choose "${OPTIONS[@]}" --height 15 --header "Option:")
    local CHOICE=$(echo "$OPT" | awk -F ' {2,}' '{print $1}' | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g')

    case "${CHOICE}" in
      init)
        init
        ;;
      manage-tools)
        manage_tools_tui
        ;;
      update-config)
        update_config
        ;;
      config-source)
        config_source
        ;;
      theme)
        set_theme
        ;;
      font)
        set_font
        ;;
      exit|q|"")
        echo "Goodbye!"
        return
        ;;
    esac
  done
}

# -- Manage tools TUI (Bubbletea)
manage_tools_tui() {
  if command -v butler-tools &>/dev/null; then
    butler-tools
  else
    echo '{{ Color "1" "butler-tools not installed" }}' | gum format -t template
    echo "The enhanced TUI requires the butler-tools binary."
    echo ""
    echo "Press any key to continue..."
    read -k 1
  fi
}

# -- Run init script
init() {
  echo '{{ Bold "# Initialize Apparatus box" }}' | gum format -t template
  echo ""
  if gum confirm "Run initialization script?"; then
    /opt/apparatus/init.sh
    echo ""
    echo '{{ Color "2" "✓ Initialization complete" }}' | gum format -t template
  fi
  echo ""
  echo "Press any key to continue..."
  read -k 1
}


# -- Update config (chezmoi diff + apply)
update_config() {
  echo '{{ Bold "# Update Configs" }}' | gum format -t template

  if [[ ! -d "${HOME}/.local/share/chezmoi" ]]; then
    echo "Chezmoi not initialized. Run Init first."
    echo ""
    echo "Press any key to continue..."
    read -k 1
    return
  fi

  # Show what would change
  local DIFF=$(chezmoi diff 2>/dev/null)
  if [[ -z "$DIFF" ]]; then
    echo "Already up to date."
    echo ""
    echo "Press any key to continue..."
    read -k 1
    return
  fi

  echo "Changes available:"
  echo "$DIFF" | head -30
  echo ""

  if gum confirm "Apply these changes?"; then
    chezmoi update --apply
    # Reload host services
    distrobox-host-exec hyprctl reload 2>/dev/null || true
    distrobox-host-exec pkill -SIGUSR1 kitty 2>/dev/null || true
    distrobox-host-exec makoctl reload 2>/dev/null || true
    echo '{{ Color "2" "✓ Configs updated" }}' | gum format -t template
  fi

  echo ""
  echo "Press any key to continue..."
  read -k 1
}

# -- Config source (switch dotfiles repo)
config_source() {
  echo '{{ Bold "# Config Source" }}' | gum format -t template
  local CURRENT="vincentvdk/apparatus-dotfiles"
  [[ -f "$HOME/.config/apparatus/chezmoi-dotfiles" ]] && CURRENT=$(cat "$HOME/.config/apparatus/chezmoi-dotfiles")
  echo "Current: $CURRENT"
  echo ""

  local REPO=$(gum input --placeholder "github-user/repo" --header "Enter dotfiles repo:")
  if [[ -n "$REPO" ]]; then
    mkdir -p "$HOME/.config/apparatus"
    echo "$REPO" > "$HOME/.config/apparatus/chezmoi-dotfiles"
    chezmoi init --purge "$REPO"
    echo '{{ Color "2" "✓ Config source updated. Run Update Config to apply." }}' | gum format -t template
  fi

  echo ""
  echo "Press any key to continue..."
  read -k 1
}

# -- Set theme
set_theme() {
  local THEMES_DIR="/usr/share/apparatus/themes"
  local HOST_HOME="$DISTROBOX_HOST_HOME"

  echo '{{ Bold "# Set theme" }}' | gum format -t template
  local CHOICE=$(gum choose \
    "catppuccin-mocha  - Dark theme" \
    "catppuccin-latte  - Light theme" \
    "Back              - Return to main menu" \
    --height 15 --header "Select theme:")

  local THEME=$(echo "$CHOICE" | awk -F ' {2,}' '{print $1}')

  case "$THEME" in
    catppuccin-mocha|catppuccin-latte)
      echo '{{ Bold "# Applying theme: " }}'"$THEME" | gum format -t template

      # Apply kitty theme
      distrobox-host-exec bash -c "[ -d '$HOST_HOME/.config/kitty' ] && ln -sf '$THEMES_DIR/$THEME/kitty.conf' '$HOST_HOME/.config/kitty/theme.conf'"

      # Apply waybar theme
      distrobox-host-exec bash -c "[ -d '$HOST_HOME/.config/waybar' ] && ln -sf '$THEMES_DIR/$THEME/waybar.css' '$HOST_HOME/.config/waybar/theme.css'"

      # Apply mako theme
      distrobox-host-exec bash -c "[ -d '$HOST_HOME/.config/mako' ] && ln -sf '$THEMES_DIR/$THEME/mako.conf' '$HOST_HOME/.config/mako/config'"

      # Apply hyprland theme
      distrobox-host-exec bash -c "[ -d '$HOST_HOME/.config/hypr' ] && ln -sf '$THEMES_DIR/$THEME/hyprland.conf' '$HOST_HOME/.config/hypr/theme.conf'"

      # Apply rio theme
      distrobox-host-exec bash -c "[ -f '$HOST_HOME/.config/rio/config.toml' ] && sed -i 's/^theme = .*/theme = \"$THEME\"/' '$HOST_HOME/.config/rio/config.toml'"

      # Apply GTK theme
      if [[ "$THEME" == *"mocha"* ]]; then
        distrobox-host-exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
      else
        distrobox-host-exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
      fi

      # Save current theme
      distrobox-host-exec bash -c "mkdir -p '$HOST_HOME/.config/apparatus' && echo '$THEME' > '$HOST_HOME/.config/apparatus/current-theme'"

      # Reload services
      distrobox-host-exec hyprctl reload 2>/dev/null || true
      distrobox-host-exec pkill -SIGUSR1 kitty 2>/dev/null || true
      distrobox-host-exec makoctl reload 2>/dev/null || true

      echo '{{ Color "2" "✓ Theme applied" }}' | gum format -t template
      ;;
    Back|"")
      return
      ;;
  esac

  echo ""
  echo "Press any key to continue..."
  read -k 1
}

# -- Set font
set_font() {
  local HOST_HOME="$DISTROBOX_HOST_HOME"
  
  echo '{{ Bold "# Set font" }}' | gum format -t template
  
  local CHOICE=$(gum choose \
    "ioskeley-mono      - Berkeley Mono alternative (Ioskeley Mono)" \
    "jetbrains-mono     - JetBrains Mono (current default)" \
    "hack-nerd-font     - Hack Nerd Font" \
    "Back               - Return to main menu" \
    --height 15 --header "Select font:")

  local FONT=$(echo "$CHOICE" | awk -F ' {2,}' '{print $1}')

  case "$FONT" in
    ioskeley-mono)
      echo '{{ Bold "# Applying font: Ioskeley Mono" }}' | gum format -t template
      
      # Update kitty font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/kitty/kitty.conf' ]]; then
          sed -i 's/^font_family.*/font_family      IoskeleyMono Nerd Font/' '$HOST_HOME/.config/kitty/kitty.conf'
        fi
      "
      
      # Update waybar font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/waybar/style.css' ]]; then
          sed -i 's/\"Hack Nerd Font\"/\"IoskeleyMono Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
          sed -i 's/\"JetBrainsMono Nerd Font\"/\"IoskeleyMono Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
        fi
      "
      
      # Update mako font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/mako/config' ]]; then
          sed -i 's/Hack Nerd Font/IoskeleyMono Nerd Font/' '$HOST_HOME/.config/mako/config'
          sed -i 's/JetBrainsMono Nerd Font/IoskeleyMono Nerd Font/' '$HOST_HOME/.config/mako/config'
        fi
      "
      
      # Save current font
      distrobox-host-exec bash -c "mkdir -p '$HOST_HOME/.config/apparatus' && echo 'ioskeley-mono' > '$HOST_HOME/.config/apparatus/current-font'"
      
      # Reload services
      distrobox-host-exec pkill -SIGUSR1 kitty 2>/dev/null || true
      distrobox-host-exec hyprctl reload 2>/dev/null || true
      distrobox-host-exec makoctl reload 2>/dev/null || true
      
      echo '{{ Color "2" "✓ Ioskeley Mono font applied" }}' | gum format -t template
      ;;
    jetbrains-mono)
      echo '{{ Bold "# Applying font: JetBrains Mono" }}' | gum format -t template
      
      # Update kitty font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/kitty/kitty.conf' ]]; then
          sed -i 's/^font_family.*/font_family      JetBrainsMono Nerd Font/' '$HOST_HOME/.config/kitty/kitty.conf'
        fi
      "
      
      # Update waybar font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/waybar/style.css' ]]; then
          sed -i 's/\"IoskeleyMono Nerd Font\"/\"JetBrainsMono Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
          sed -i 's/\"Hack Nerd Font\"/\"JetBrainsMono Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
        fi
      "
      
      # Update mako font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/mako/config' ]]; then
          sed -i 's/IoskeleyMono Nerd Font/JetBrainsMono Nerd Font/' '$HOST_HOME/.config/mako/config'
          sed -i 's/Hack Nerd Font/JetBrainsMono Nerd Font/' '$HOST_HOME/.config/mako/config'
        fi
      "
      
      # Save current font
      distrobox-host-exec bash -c "mkdir -p '$HOST_HOME/.config/apparatus' && echo 'jetbrains-mono' > '$HOST_HOME/.config/apparatus/current-font'"
      
      # Reload services
      distrobox-host-exec pkill -SIGUSR1 kitty 2>/dev/null || true
      distrobox-host-exec hyprctl reload 2>/dev/null || true
      distrobox-host-exec makoctl reload 2>/dev/null || true
      
      echo '{{ Color "2" "✓ JetBrains Mono font applied" }}' | gum format -t template
      ;;
    hack-nerd-font)
      echo '{{ Bold "# Applying font: Hack Nerd Font" }}' | gum format -t template
      
      # Update kitty font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/kitty/kitty.conf' ]]; then
          sed -i 's/^font_family.*/font_family      Hack Nerd Font/' '$HOST_HOME/.config/kitty/kitty.conf'
        fi
      "
      
      # Update waybar font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/waybar/style.css' ]]; then
          sed -i 's/\"IoskeleyMono Nerd Font\"/\"Hack Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
          sed -i 's/\"JetBrainsMono Nerd Font\"/\"Hack Nerd Font\"/' '$HOST_HOME/.config/waybar/style.css'
        fi
      "
      
      # Update mako font
      distrobox-host-exec bash -c "
        if [[ -f '$HOST_HOME/.config/mako/config' ]]; then
          sed -i 's/IoskeleyMono Nerd Font/Hack Nerd Font/' '$HOST_HOME/.config/mako/config'
          sed -i 's/JetBrainsMono Nerd Font/Hack Nerd Font/' '$HOST_HOME/.config/mako/config'
        fi
      "
      
      # Save current font
      distrobox-host-exec bash -c "mkdir -p '$HOST_HOME/.config/apparatus' && echo 'hack-nerd-font' > '$HOST_HOME/.config/apparatus/current-font'"
      
      # Reload services
      distrobox-host-exec pkill -SIGUSR1 kitty 2>/dev/null || true
      distrobox-host-exec hyprctl reload 2>/dev/null || true
      distrobox-host-exec makoctl reload 2>/dev/null || true
      
      echo '{{ Color "2" "✓ Hack Nerd Font applied" }}' | gum format -t template
      ;;
    Back|"")
      return
      ;;
  esac

  echo ""
  echo "Press any key to continue..."
  read -k 1
}

# Main
main
